generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id                   String    @id @default(cuid())
  username             String    @unique
  firstName            String?
  lastName             String?
  email                String    @unique
  passwordHash         String    @default("")
  inviteTokenHash      String?
  inviteTokenExpiresAt DateTime?
  resetTokenHash       String?
  resetTokenExpiresAt  DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model CallerApiKey {
  id          String    @id @default(cuid())
  name        String
  description String    @default("")
  keyHash     String    @unique
  prefix      String
  /** Plaintext caller secret for admin Copy; null on pre-migration rows. */
  secret      String?
  status      String    @default("ACTIVE")
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/** ADR-046 / MVP-16 — trip ledger (PG authority + memory hot replica). */
model Trip {
  id          String   @id @default(cuid())
  revision    Int      @default(1)
  status      String   @default("active")
  callerKey   String
  locale      String?
  expiresAt   DateTime
  constraints Json?
  candidates  Json?
  skeleton    Json?
  cursor      Json?
  filled      Json?
  artifacts   Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([callerKey, expiresAt])
}
