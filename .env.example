# places-agent — env names only. Copy to .env.local and fill values. Never commit secrets.
# Port registry: ../../workspace-specs/6.deployment-plan.md §0 — local PORT=3010, Postgres 5435 (or 5436)

APP_NAME=places-agent
# Local dev default is 3010 (see Makefile / scripts/dev-server.sh). Production container uses 3000.
PORT=3010
SESSION_SECRET=change-me-in-local
# Local Postgres: :5435 shared with what2eat (dedicated dbs) or :5436 places-agent compose
DATABASE_URL=postgresql://places_agent:places_agent@localhost:5435/places_agent
PROMPT_ID=chat.v1
GLOSSARY_ID=
CATALOG_PACK=catalogs.v1

# Local/dev only — hashed into the seed admin. Empty in production images.
DEV_ADMIN_PASSWORD=

# Vendor mode: fixture (default, HK/Shanghai sample data) | live (real map APIs)
# TC-C06/C07 and TC-H14/H15 require live + keys below.
PLACES_VENDOR_MODE=fixture

# Next.js dev — comma-separated LAN IPs/hostnames for cross-machine invite/HMR (optional)
ALLOWED_DEV_ORIGINS=

# Quanzil LLM — optional fixture mode; also skipped when OPENAI_API_KEY is empty or PLACES_VENDOR_MODE=fixture
QUANZIL_MODE=
OPENAI_API_KEY=
OPENAI_HOST=quanzil.com
OPENAI_BASE_URL=https://quanzil.com/v1
OPENAI_CHAT_MODEL=gpt-5.4
OPENAI_KEY_MGMT_SITE=https://quanzil.com/console/token
# Structured arrange/plan often needs >45s against Quanzil (default in code: 90000)
LLM_ARRANGE_TIMEOUT_MS=90000
LLM_ITINERARY_TIMEOUT_MS=90000

# Map vendors (server only — never NEXT_PUBLIC_*)
AMAP_API_KEY=
AMAP_HOST=restapi.amap.com
AMAP_BASE_URL=https://restapi.amap.com

# Google Maps — direct REST (Places API New + Geocoding). WGS-84.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_HOST=maps.googleapis.com
GOOGLE_MAPS_BASE_URL=https://maps.googleapis.com
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com/v1
GOOGLE_MAPS_PROJECT=

# ADR-017 — Cloudflare Worker MCP (internal transport fallback, not a providers[] id)
# Used when direct maps.googleapis.com egress fails. Provenance stays GOOGLE_MAPS.
# Required for live Google on mainland or TC-C07 / TC-H15 dev verification.
GMAPS_MCP_HOST=maps-mcp.woodensword.studio
GMAPS_MCP_URL=https://maps-mcp.woodensword.studio/mcp
GMAPS_MCP_BEARER=

# Dev-only — simulate direct Google egress failure (VPN on). Values: 1 | true | yes
# Run: make verify-gmaps-fallback  or  GOOGLE_DIRECT_FORCE_FAIL=1 make dev
# Alternative blackhole: GOOGLE_MAPS_BASE_URL=http://127.0.0.1:9
# Rejected at startup when NODE_ENV=production — never set in Portainer prod.
GOOGLE_DIRECT_FORCE_FAIL=

TRIPADVISOR_API_KEY=
TRIPADVISOR_HOST=terra.tripadvisor.com
TRIPADVISOR_BASE_URL=https://terra.tripadvisor.com/api

# Weather (MVP-2)
OPEN_METEO_HOST=api.open-meteo.com
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_API_KEY=

# Orizn Visa (MVP-11 — server only; ADR-044)
ORIZN_API_KEY=
ORIZN_VISA_BASE_URL=https://visa.orizn.app/api/v1
ORIZN_CACHE_TTL_H=24

# Local origin for invite/reset links (absolute URLs in mail). Match PORT.
PUBLIC_BASE_URL=http://localhost:3010
APP_URL=http://localhost:3010

# Mail
RESEND_API_KEY=
RESEND_HOST=api.resend.com
RESEND_BASE_URL=https://api.resend.com
RESEND_FROM_EMAIL=

# Tests
TEST_DATABASE_URL=postgresql://places_agent:places_agent@localhost:5435/places_agent_test
