# places-agent — env codes only. Copy to .env.local. Never commit secrets.

APP_NAME=places-agent
PORT=3000
SESSION_SECRET=change-me-in-local
DATABASE_URL=file:../.data/places-agent.db
PROMPT_ID=chat.v1
GLOSSARY_ID=
CATALOG_PACK=catalogs.v1

# Local/dev only — hashed into the seed admin. Empty in production images.
DEV_ADMIN_PASSWORD=

# Fixture vendors unless set to live
PLACES_VENDOR_MODE=fixture

# Quanzil (not used in MVP-1 NL chat)
OPENAI_API_KEY=
OPENAI_HOST=quanzil.com
OPENAI_BASE_URL=https://quanzil.com/v1
OPENAI_CHAT_MODEL=gpt-5.4
OPENAI_KEY_MGMT_SITE=https://quanzil.com/console/token

# Map vendors (server only)
AMAP_API_KEY=
AMAP_HOST=restapi.amap.com
AMAP_BASE_URL=https://restapi.amap.com
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_HOST=maps.googleapis.com
GOOGLE_MAPS_BASE_URL=https://maps.googleapis.com
GOOGLE_MAPS_PROJECT=
GMAPS_MCP_HOST=
GMAPS_MCP_URL=
GMAPS_MCP_BEARER=
TRIPADVISOR_API_KEY=
TRIPADVISOR_HOST=terra.tripadvisor.com
TRIPADVISOR_BASE_URL=https://terra.tripadvisor.com/api

# Weather (MVP-2)
OPEN_METEO_HOST=api.open-meteo.com
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_API_KEY=

# Local origin for invite/reset links (absolute URLs in mail)
PUBLIC_BASE_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Mail
RESEND_API_KEY=
RESEND_HOST=api.resend.com
RESEND_BASE_URL=https://api.resend.com
RESEND_FROM_EMAIL=

# Tests
TEST_DATABASE_URL=file:./.data/places-agent-test.db
